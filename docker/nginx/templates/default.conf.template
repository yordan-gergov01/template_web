# Rendered at container start by the image's envsubst step; only
# ${BACKEND_ORIGIN} is substituted (NGINX_ENVSUBST_FILTER), nginx variables
# such as $uri stay as they are.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Written at container start from BACKEND_URL (docker/entrypoint.d).
    location = /config.js {
        alias /tmp/runtime/config.js;
    }

    # Client-side routes fall back to the app.
    location / {
        try_files $uri /index.html;
    }
}
