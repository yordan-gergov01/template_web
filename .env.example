# Environment template for template_web.
#
# Copy it to .env (which Git ignores) and adjust the values:
#   cp .env.example .env
#
# Every value here is a placeholder for local development only.

# Base URL of the template_core backend as the browser reaches it (http or https,
# no trailing path). Written into /config.js when the container starts, so one
# image works in every environment. The backend must list this app's origin in
# its CORS_ALLOWED_ORIGINS.
BACKEND_URL=http://localhost:8000

# Host port of the frontend. The origin http://localhost:<port> must match the
# backend's CORS_ALLOWED_ORIGINS (default http://localhost:3000).
FRONTEND_PORT=3000
